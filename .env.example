# demo/live is chosen per project. Models are intentionally blank: use IDs enabled in your account.
DATABASE_URL=sqlite:///./data/studio.db
EXECUTION_MODE=local
REDIS_URL=redis://localhost:6379/0
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TEXT_MODEL=
# auto preserves compatibility with ep-*; json_object/json_schema require model support.
TEXT_RESPONSE_FORMAT=auto
SEEDREAM_MODEL=
SEEDREAM_SIZE=2K
SEEDANCE_MODEL=
# Must be supported by your configured model. Timeline duration is independent.
SEEDANCE_CLIP_SECONDS=5
SEEDANCE_RESOLUTION=720p
OUTPUT_SHORT_EDGE=720
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=
MINIMAX_VOICE=male-qn-qingse
# Optional native ComfyUI server (not Comfy Cloud API). Leave blank to use Seedream.
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COMFYUI_TIMEOUT_SECONDS=900
COMFYUI_POLL_INTERVAL_SECONDS=2
PROVIDER_INTERVAL_SECONDS=2
POLL_INTERVAL_SECONDS=10
VIDEO_TIMEOUT_SECONDS=1800
REQUEST_TIMEOUT_SECONDS=180
# Optional: otherwise discover system FFmpeg or imageio-ffmpeg bundled executable.
FFMPEG_PATH=
FONT_PATH=
