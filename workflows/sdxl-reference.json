{
  "name":"参考图分镜 · SDXL图生图模板",
  "description":"基础图生图，参考构图和色彩，不保证人物身份一致。需上传参考图并把checkpoint名称替换为已安装模型。人物参考/IP-Adapter/LoRA需另行导入已跑通工作流。",
  "workflow":{
    "3":{"class_type":"KSampler","inputs":{"seed":2026,"steps":24,"cfg":7,"sampler_name":"euler","scheduler":"normal","denoise":0.55,"model":["4",0],"positive":["6",0],"negative":["7",0],"latent_image":["12",0]}},
    "4":{"class_type":"CheckpointLoaderSimple","inputs":{"ckpt_name":"REPLACE_WITH_INSTALLED_CHECKPOINT.safetensors"}},
    "6":{"class_type":"CLIPTextEncode","inputs":{"text":"cinematic landscape","clip":["4",1]}},
    "7":{"class_type":"CLIPTextEncode","inputs":{"text":"text, watermark, blurry, distorted","clip":["4",1]}},
    "8":{"class_type":"VAEDecode","inputs":{"samples":["3",0],"vae":["4",2]}},
    "9":{"class_type":"SaveImage","inputs":{"filename_prefix":"FrameflowReference","images":["8",0]}},
    "10":{"class_type":"LoadImage","inputs":{"image":"REFERENCE_REQUIRED.png"}},
    "11":{"class_type":"ImageScale","inputs":{"image":["10",0],"upscale_method":"lanczos","width":768,"height":1344,"crop":"center"}},
    "12":{"class_type":"VAEEncode","inputs":{"pixels":["11",0],"vae":["4",2]}}
  },
  "bindings":{"prompt":{"node":"6","input":"text"},"width":{"node":"11","input":"width"},"height":{"node":"11","input":"height"},"seed":{"node":"3","input":"seed"},"reference":{"node":"10","input":"image"}},
  "output_node":"9"
}
